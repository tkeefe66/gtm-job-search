{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.backup"
  },
  "deploy": {
    "startCommand": "node db/backup.mjs",
    "healthcheckPath": null,
    "restartPolicyType": "NEVER",
    "cronSchedule": "0 6 * * *"
  }
}
